# =========================================================
# SUNU MALL — Variables d'environnement Backend (TEMPLATE)
# =========================================================

# Django
DEBUG=False
# Le code lit DJANGO_SECRET_KEY (pas SECRET_KEY) — ce nom doit être respecté
# pour que cette valeur soit réellement prise en compte.
DJANGO_SECRET_KEY=remplacez-par-une-cle-aleatoire-longue-et-securisee
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,votre-domaine.example

# Base de données (Neon en production, Postgres local sinon)
DATABASE_URL=
POSTGRES_DB=sunu_mall
POSTGRES_USER=sunu_mall
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-securise
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MinIO / Stockage media
MINIO_ACCESS_KEY=remplacez-par-un-identifiant-de-stockage
MINIO_SECRET_KEY=remplacez-par-un-secret-long-et-aleatoire
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sunu-mall-media
MINIO_PUBLIC_ENDPOINT=localhost:9010

# CORS : origines autorisées (frontend Vite, nginx)
CORS_ALLOWED_ORIGINS=https://votre-domaine.example
CSRF_TRUSTED_ORIGINS=https://votre-domaine.example

# URL du frontend, utilisée pour construire les liens dans les emails
# (vérification d'email, notifications...). Doit correspondre au port
# réel du frontend Vite (voir frontend/vite.config.ts : server.port).
FRONTEND_URL=https://votre-domaine.example

# Clé API Anthropic (Claude) — génération de description produit + assistant
# client (apps/ia/). Générer la tienne sur console.anthropic.com.
ANTHROPIC_API_KEY=

# SMTP réel — sans ça, EMAIL_BACKEND retombe sur le backend "console"
# (rien n'est réellement délivré, juste imprimé dans les logs). Pour
# Gmail : active la validation en 2 étapes puis génère un mot de passe
# d'application sur https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Paiement NabooPay v2 — laisser PAYMENT_SANDBOX=True en local
PAYMENT_SANDBOX=True
NABOOPAY_API_KEY=
NABOOPAY_BASE_URL=https://api.naboopay.com
NABOOPAY_WEBHOOK_SECRET=

# Session navigateur : préférer frontend et API sous le même domaine.
AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Nombre exact de reverse proxies de confiance devant Django (prod).
TRUSTED_PROXY_COUNT=1
# Production : activer SMTP et définir les origines HTTPS explicitement.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# CSRF_TRUSTED_ORIGINS=https://votre-domaine.example
# CORS_ALLOWED_ORIGINS=https://votre-domaine.example
NABOOPAY_TIMEOUT=15
NABOOPAY_IS_ESCROW=False
NABOOPAY_FEES_CUSTOMER_SIDE=True
