# =========================================================
# SUNU MALL — Variables d'environnement Backend (TEMPLATE)
# =========================================================

# Django
DEBUG=True
SECRET_KEY=remplacez-par-votre-cle-secrete-tres-securisee
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Base de données (doit correspondre à infra/env/postgres.env)
POSTGRES_DB=sunu_mall
POSTGRES_USER=sunu_mall
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-securise
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# MinIO / Stockage media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sunu-mall-media
MINIO_PUBLIC_ENDPOINT=localhost:9010

# CORS : origines autorisées (frontend Vite, nginx)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3010,http://localhost:3011,http://localhost:8081

# URL du frontend, utilisée pour construire les liens dans les emails
# (vérification d'email, notifications...). Doit correspondre au port
# réel du frontend Vite (voir frontend/vite.config.ts : server.port).
FRONTEND_URL=http://localhost:3004
